# MIUI camera running as priv_app (APK not platform-signed: seapp_contexts
# falls through to priv_app). Vendor-type rules live in
# sepolicy/vendor/priv_app_camera.te.

# ROUND ONE: permissive on userdebug/eng only. Covers every priv-app, so the
# log is noisy by design — filter by app=com.android.camera. Collect, write
# the allows, then DELETE this block. User builds stay enforcing and green.
userdebug_or_eng(`
  permissive priv_app;
')

# NOTE: the base rule lists a `default_android_hwservice` find, but AOSP
# domain.te neverallows every domain from finding the unlabeled HIDL
# catch-all. The camera talks to the AIDL vendor.mediatek.hardware.camera.isphal
# HAL, which is a service_manager lookup — if round one still logs a
# hwservice_manager denial, label that specific service in a
# vendor/hwservice_contexts and find its own type instead.

# The algo threads statfs() the dmabuf filesystem, which carries no label.
allow priv_app unlabeled:filesystem getattr;

# Memory-pressure feedback for the capture pipeline.
allow priv_app proc_pressure_cpu:file r_file_perms;
allow priv_app proc_pressure_mem:file r_file_perms;
allow priv_app proc_pressure_io:file r_file_perms;

# Emulator compat (ro.kernel.qemu).
get_prop(priv_app, qemu_hw_prop)

# Audio tuning readback for video recording.
get_prop(priv_app, audio_config_prop)

# Extra camera modes dlopen .so extracted into the private data dir.
allow priv_app privapp_data_file:file execute;
