type miuicamera_app, domain, coredomain;
app_domain(miuicamera_app)
net_domain(miuicamera_app)

# ROUND ONE: permissive on userdebug/eng only, so the app logs every denial
# instead of malfunctioning on the first one. Collect them, write the allows,
# then DELETE this block. User builds stay enforcing (compiles out) and green
# in compat_test.
userdebug_or_eng(`
  permissive miuicamera_app;
')

# app_domain + net_domain already cover binder/hwbinder, camera, audio,
# media, graphics, network and storage.
#
# Vendor-partition rules for this domain live in
# sepolicy/vendor/miuicamera_app.te; vendor types are not visible here.

# Talks to the camera HAL (vendor declares mtk_hal_camera as hal_camera server).
hal_client_domain(miuicamera_app, hal_camera)

# The algo threads statfs() the dmabuf filesystem, which carries no label.
allow miuicamera_app unlabeled:filesystem getattr;

# Memory-pressure feedback for the capture pipeline.
allow miuicamera_app proc_pressure_cpu:file r_file_perms;
allow miuicamera_app proc_pressure_mem:file r_file_perms;
allow miuicamera_app proc_pressure_io:file r_file_perms;

# Emulator compat (ro.kernel.qemu).
get_prop(miuicamera_app, qemu_hw_prop)

# Extra camera modes (e.g. long exposure) dlopen .so extracted here.
allow miuicamera_app privapp_data_file:file execute;

# persist.vendor.camera.privapp.list (same as priv_app/platform_app/cameraserver).
get_prop(miuicamera_app, vendor_persist_camera_prop)
