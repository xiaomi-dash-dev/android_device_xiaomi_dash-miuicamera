# Vendor-partition client rules for the MIUI camera app domain defined in
# sepolicy/private/miuicamera_app.te. Vendor-defined types are not visible
# to private policy, so anything vendor-side lives here.

# Binds the MTK camera HAL directly (base module denial).
binder_call(miuicamera_app, mtk_hal_camera)

# Board temperature feedback while recording.
r_dir_file(miuicamera_app, sysfs_therm)

# Xiaomi MiSys + post-proc services the app binds to (see service_contexts).
allow miuicamera_app misys_core_service:service_manager find;
allow miuicamera_app misys_impl_service:service_manager find;
allow miuicamera_app hal_misys_vendor_service:service_manager find;
binder_call(miuicamera_app, misys_core)
