type hypsys_vendor, domain;
type hypsys_vendor_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hypsys_vendor)
binder_use(hypsys_vendor)

# Talks to servicemanager at startup; a denied call aborts the daemon.
allow hypsys_vendor servicemanager:binder { call transfer };

# Persists state under /data/vendor (observed create/write/setattr).
allow hypsys_vendor vendor_data_file:dir { create open getattr search setattr write };
allow hypsys_vendor vendor_data_file:file { getattr open read setattr write };

# ChargerLogger: battery/thermal sysfs, bsp log and uevents.
allow hypsys_vendor sysfs:file { getattr open read write };
r_dir_file(hypsys_vendor, sysfs_batteryinfo)
r_dir_file(hypsys_vendor, sysfs_therm)
allow hypsys_vendor vendor_bsp_data_log_file:dir search;
allow hypsys_vendor vendor_bsp_data_log_file:file { getattr open read setattr write };
allow hypsys_vendor self:netlink_kobject_uevent_socket read;
